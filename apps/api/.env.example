PORT=3000

# One process, three DB roles — the least-privilege boundary from SCHEMA.sql
# is preserved even though it's a single deployable today (BUILD_LOG_CLAUDE.md
# "Pivot" entry). Splitting into separate services later is a matter of giving
# each module its own process and swapping its port's DI provider for an HTTP
# adapter — the pools/roles/SQL don't change.
AUTH_DATABASE_URL=postgres://auth_svc:changeme_auth@localhost:6432/pstu
LEDGER_DATABASE_URL=postgres://txn_svc:changeme_txn@localhost:6432/pstu
READ_DATABASE_URL=postgres://read_svc:changeme_read@localhost:6432/pstu

JWT_PRIVATE_KEY_PATH=../../infra/keys/private.pem
JWT_PUBLIC_KEY_PATH=../../infra/keys/public.pem

BCRYPT_COST=10
FAILED_PIN_LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SIGNUP_BONUS_PAISA=10000000

DAILY_LIMIT_DEFAULT_PAISA=5000000
STEP_UP_AMOUNT_THRESHOLD_PAISA=2000000
UNDO_WINDOW_SECONDS=60
SWEEPER_INTERVAL_MS=5000
UNDO_THRESHOLD_PAISA=500000

DISPUTE_WINDOW_DAYS=7

CENTRIFUGO_TOKEN_SECRET=changeme_centrifugo_secret
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
